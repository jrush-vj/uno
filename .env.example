# Copy this file to `.env` and fill in your own values: `cp .env.example .env`

# --- Domain / TLS (used by Caddy for automatic HTTPS + wss) -------------------
# Point this domain's DNS A/AAAA record at your host. Caddy will obtain a
# Let's Encrypt certificate automatically. For pure-LAN use, see Caddyfile.
DOMAIN=uno.example.com

# --- TURN relay (coturn) ------------------------------------------------------
# Required for reliable video/audio between players on different networks
# (phone on cellular <-> laptop on WiFi, strict/symmetric NATs, etc.).
TURN_REALM=uno.local
# The address browsers will be told to use for the relay. Use your public IP
# (or public hostname) and port 3478.
TURN_URL=turn:YOUR_PUBLIC_IP:3478
TURN_USERNAME=uno
TURN_CREDENTIAL=change-me-to-a-strong-password
# Set only when the host is behind NAT: the public IP coturn should advertise.
# Leave empty when the host has a directly routable public IP.
TURN_EXTERNAL_IP=

# --- Server -------------------------------------------------------------------
PORT=8899
# Comma-separated list of allowed browser Origins for the WebSocket.
# Empty = allow any origin (fine for a private homelab, but set it for public
# deployments, e.g. ALLOWED_ORIGINS=https://uno.example.com).
ALLOWED_ORIGINS=
# Maximum number of concurrent rooms before the server rejects new ones.
MAX_ROOMS=200

# --- Optional server tuning ---------------------------------------------------
# Largest accepted WebSocket message, in bytes.
# MAX_MESSAGE_BYTES=65536
# Per-connection message rate limit (messages per second). Set to 0 to disable.
# RATE_LIMIT_PER_SEC=100
